se","parTour":1,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"ligne","taille":3,"tailleMin":0,"baisse":false},"touche":"ennemis","effets":[{"type":"degats","element":"S","min":20,"max":24,"maitre":[25,30]}],"texte":"Un courant d'air en tablier : on l'a à peine vu passer.","change":"Le geindre ne reste plus : il passe en courant d'air et frappe tout de suite chaque ennemi d'une ligne de 4 cases, en Soufflé."},{"id":"levainqueur.pain-perdu","classe":"levainqueur","emplacement":15,"declinaisonDe":null,"niveau":182,"nom":"Pain perdu","element":"E","cm":4,"rayon":{"min":1,"max":4,"modifiable":true},"lancer":"libre","vue":true,"cible":"ennemi","parTour":1,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"E","min":19,"max":24,"maitre":[24,30]},{"type":"retire","quoi":"cm","n":2}],"texte":"Le pain perdu ne l'est pas pour tout le monde : la cible perd 2 coups de main.","change":""},{"id":"levainqueur.pain-dore","classe":"levainqueur","emplacement":15,"declinaisonDe":"levainqueur.pain-perdu","niveau":190,"nom":"Pain doré","element":"F","cm":4,"rayon":{"min":1,"max":4,"modifiable":false},"lancer":"ligne","vue":true,"cible":"ennemi","parTour":1,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":15,"zone":{"forme":"ligne","taille":1,"tailleMin":0,"baisse":false},"touche":"ennemis","effets":[{"type":"degats","element":"F","min":24,"max":30,"maitre":[30,38]}],"texte":"Doré des deux côtés.","change":"Le pain perdu, doré à la poêle : il ne vole plus de coups de main, il frappe fort la cible et l'ennemi juste derrière, en Flambée."},{"id":"levainqueur.chef-d-oeuvre-la-grande-fournee","classe":"levainqueur","emplacement":16,"declinaisonDe":null,"niveau":200,"nom":"Chef-d'œuvre : la Grande Fournée","element":"F","cm":7,"rayon":{"min":0,"max":0,"modifiable":false},"lancer":"libre","vue":false,"cible":"soi","parTour":1,"parCible":0,"relance":5,"relanceInitiale":2,"plafondPose":0,"maitre":15,"zone":{"forme":"rond","taille":3,"tailleMin":1,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"F","min":40,"max":50,"maitre":[50,63]},{"type":"renforce","quoi":"famille:fournee","valeur":50,"tours":2,"fois":0}],"texte":"Le grand four s'ouvre : tout brûle autour de toi, et ce qui cuit encore éclate 50 % plus fort pendant 2 tours.","change":""},{"id":"levainqueur.chef-d-oeuvre-le-grand-petrin","classe":"levainqueur","emplacement":16,"declinaisonDe":"levainqueur.chef-d-oeuvre-la-grande-fournee","niveau":200,"nom":"Chef-d'œuvre : le Grand Pétrin","element":"E","cm":7,"rayon":{"min":0,"max":0,"modifiable":false},"lancer":"libre","vue":false,"cible":"soi","parTour":1,"parCible":0,"relance":5,"relanceInitiale":2,"plafondPose":0,"maitre":5,"zone":{"forme":"terrain","taille":0,"tailleMin":0,"baisse":false},"touche":"ennemis","effets":[{"type":"degats","element":"E","min":28,"max":35,"maitre":[35,44]},{"type":"retire","quoi":"pas","n":2}],"texte":"Tout le monde dans le pétrin : la pâte trop mouillée colle à tous les pieds.","change":"Au lieu d'ouvrir le grand four autour de toi, tu mets tout le terrain dans le pétrin : moins fort, mais chaque ennemi est touché et perd 2 Pas, en Eaudace."}]