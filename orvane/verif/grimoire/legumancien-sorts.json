aute sur un ennemi proche. Un seul à la fois.","change":"L'épouvantail ne fait plus reculer : il sert de paratonnerre, et pendant 2 tours la foudre frappe en Éclair les ennemis à 2 cases ou moins de lui, avec un rebond."},{"id":"legumancien.celeri-branche","classe":"legumancien","emplacement":15,"declinaisonDe":null,"niveau":182,"nom":"Céleri branché","element":"C","cm":4,"rayon":{"min":2,"max":6,"modifiable":true},"lancer":"libre","vue":true,"cible":"ennemi","parTour":1,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"C","min":24,"max":28,"maitre":[30,35]},{"type":"bonus","carac":"pas","valeur":2,"tours":1,"qui":"soi"}],"texte":"Une branche de céleri branchée sur l'orage : la décharge part, et la célérité te donne 2 Pas pour ce tour.","change":""},{"id":"legumancien.jus-de-celeri","classe":"legumancien","emplacement":15,"declinaisonDe":"legumancien.celeri-branche","niveau":190,"nom":"Jus de céleri","element":"E","cm":4,"rayon":{"min":1,"max":4,"modifiable":true},"lancer":"ligne","vue":true,"cible":"case","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"ligne","taille":4,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"E","min":20,"max":23,"maitre":[25,29]},{"type":"etat","etat":"ramolli","tours":1,"couches":1}],"texte":"Une branche de céleri pressée d'un coup : le jus gicle sur toute la ligne et colle aux pieds.","change":"Le céleri ne donne plus de Pas : pressé d'un coup, son jus traverse une ligne de 5 cases en Eaudace et ramollit les ennemis."},{"id":"legumancien.chef-d-oeuvre-la-grande-recolte","classe":"legumancien","emplacement":16,"declinaisonDe":null,"niveau":200,"nom":"Chef-d'œuvre : la Grande Récolte","element":"T","cm":7,"rayon":{"min":0,"max":0,"modifiable":false},"lancer":"libre","vue":false,"cible":"soi","parTour":1,"parCi