[{"id":"legumancien.semis","classe":"legumancien","emplacement":1,"declinaisonDe":null,"niveau":1,"nom":"Semis","element":"T","cm":3,"rayon":{"min":1,"max":3,"modifiable":false},"lancer":"libre","vue":false,"cible":"caseLibre","parTour":1,"parCible":0,"relance":0,"relanceInitiale":0,"plafondPose":2,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"pose","quoi":"graine","tours":1,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","maitre":0,"effets":[],"commis":{"nom":"Radis furieux","victuailles":24,"cm":4,"pas":3,"ouverture":0,"rideau":6,"fauxFuyant":2,"comportement":"colle","sorts":[{"id":"legumancien.croque-au-sel","classe":"legumancien","declinaisonDe":null,"niveau":1,"nom":"Croque-au-sel","element":"T","cm":2,"rayon":{"min":1,"max":1,"modifiable":false},"lancer":"libre","vue":true,"cible":"ennemi","parTour":2,"parCible":2,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"T","min":7,"max":9,"maitre":[9,11]}],"texte":"Le Radis furieux se croque cru, mais lui aussi croque : il mord l'ennemi au contact, plus fort que l'étincelle du Radis survolté.","change":""}]}}],"texte":"Qui sème des radis récolte des morsures. La graine germe au tour suivant : un Radis furieux sort de terre et mord les ennemis au contact. Un radis pousse vite : tu peux en semer un à chaque tour, sans attendre. Deux graines au plus en terre : la seconde attend qu'une place de Commis se libère.","change":""},{"id":"legumancien.semis-conducteur","classe":"legumancien","emplacement":1,"declinaisonDe":"legumancien.semis","niveau":3,"nom":"Semis-conducteur","element":"C","cm":3,"rayon":{"min":1,"max":4,"modifiable":false},"lancer":"libre","vue":false,"cible":"caseLibre","parTour":1,"parCible":0,"relance":0,"relanceInitiale":0,"plafondPose":2,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"pose","quoi":"graine","tours":1,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","maitre":0,"effets":[],"commis":{"nom":"Radis survolté","victuailles":16,"cm":4,"pas":4,"ouverture":0,"rideau":0,"fauxFuyant":10,"comportement":"tire","sorts":[{"id":"legumancien.court-jus","classe":"legumancien","declinaisonDe":null,"niveau":3,"nom":"Court-jus","element":"C","cm":2,"rayon":{"min":2,"max":4,"modifiable":false},"lancer":"libre","vue":true,"cible":"ennemi","parTour":2,"parCible":2,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"C","min":6,"max":8,"maitre":[8,10]},{"type":"rebond","fois":1,"rayon":2,"part":50}],"texte":"Une étincelle de radis frappe un ennemi, puis saute sur l'ennemi le plus proche.","change":""}]}}],"texte":"Un semi-conducteur, mais en graine : le courant la porte un peu plus loin, jusqu'à 4 cases. Le Radis survolté reste à distance et lance des étincelles qui sautent d'un ennemi à l'autre.","change":"La graine donne un Radis survolté à la place du Radis furieux : plus fragile et plus rapide, il fuit le contact et tire de loin en Éclair, avec une étincelle qui rebondit, au lieu de mordre. Elle se sème aussi un peu plus loin (4 cases au lieu de 3)."},{"id":"legumancien.navet-en-cloche","classe":"legumancien","emplacement":2,"declinaisonDe":null,"niveau":1,"nom":"Navet en cloche","element":"T","cm":2,"rayon":{"min":2,"max":6,"modifiable":false},"lancer":"libre","vue":false,"cible":"ennemi","parTour":3,"parCible":2,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"T","min":8,"max":10,"maitre":[10,13]}],"texte":"Ce navet fait un carton. Tiré en cloche par-dessus tes légumes, il passe au-dessus des obstacles, mais ne tombe jamais à moins de 2 cases de toi. Un petit navet part vite : jusqu'à trois par tour, deux sur la même cible.","change":""},{"id":"legumancien.rutabagarre","classe":"legumancien","emplacement":2,"declinaisonDe":"legumancien.navet-en-cloche","niveau":5,"nom":"Rutabagarre","element":"T","cm":3,"rayon":{"min":1,"max":1,"modifiable":false},"lancer":"libre","vue":true,"cible":"ennemi","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"T","min":15,"max":19,"maitre":[19,24]},{"type":"pousse","cases":2}],"texte":"La bagarre au rutabaga, le gros cousin du navet : un coup au contact qui renvoie l'ennemi deux cases plus loin. S'il bute contre un de tes légumes, c'est l'ennemi qui s'écrase, pas le légume.","change":"On ne tire plus le navet en cloche, on cogne avec le rutabaga : un seul gros coup au contact (3 coups de main au lieu de 2), presque deux fois plus fort, qui repousse de 2 cases."},{"id":"legumancien.repiquage","classe":"legumancien","emplacement":3,"declinaisonDe":null,"niveau":1,"nom":"Repiquage","element":"N","cm":2,"rayon":{"min":1,"max":6,"modifiable":false},"lancer":"libre","vue":false,"cible":"allie","parTour":1,"parCible":0,"relance":2,"relanceInitiale":0,"plafondPose":0,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"allies","effets":[{"type":"echange"}],"texte":"Au potager, repiquer, c'est déterrer un plant et le replanter ailleurs. Ici, tu changes de place avec un allié, souvent un de tes légumes, par les racines : pas besoin de le voir.","change":""},{"id":"legumancien.flageolet","classe":"legumancien","emplacement":3,"declinaisonDe":"legumancien.repiquage","niveau":7,"nom":"Flageolet","element":"S","cm":3,"rayon":{"min":1,"max":4,"modifiable":true},"lancer":"ligne","vue":true,"cible":"case","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"ligne","taille":2,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"S","min":12,"max":15,"maitre":[15,19]}],"texte":"Ce haricot est aussi une petite flûte, et il siffle fort : le son traverse toute une ligne d'ennemis.","change":"On ne change plus de place : le flageolet, haricot et petite flûte, siffle des dégâts Soufflé sur une ligne de 3 cases."},{"id":"legumancien.piment-vif","classe":"legumancien","emplacement":4,"declinaisonDe":null,"niveau":10,"nom":"Piment vif","element":"F","cm":2,"rayon":{"min":2,"max":5,"modifiable":true},"lancer":"libre","vue":true,"cible":"ennemi","parTour":3,"parCible":2,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":15,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"F","min":8,"max":11,"maitre":[10,14]},{"type":"etat","etat":"brule","tours":2,"couches":1}],"texte":"Un piment qui pique au vif : la cible brûle encore pendant 2 tours.","change":""},{"id":"legumancien.piment-d-artifice","classe":"legumancien","emplacement":4,"declinaisonDe":"legumancien.piment-vif","niveau":18,"nom":"Piment d'artifice","element":"F","cm":3,"rayon":{"min":2,"max":5,"modifiable":true},"lancer":"libre","vue":true,"cible":"case","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":20,"zone":{"forme":"croix","taille":1,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"F","min":12,"max":15,"maitre":[15,19]}],"texte":"Le piment éclate en feu d'artifice : une croix d'étincelles, et souvent le bouquet final.","change":"Le piment ne vise plus une seule cible : il éclate en feu d'artifice sur une croix, pour 1 coup de main de plus, avec plus de coups de maître mais sans Brûlé."},{"id":"legumancien.bouillon-de-legumes","classe":"legumancien","emplacement":5,"declinaisonDe":null,"niveau":26,"nom":"Bouillon de légumes","element":"N","cm":2,"rayon":{"min":0,"max":4,"modifiable":false},"lancer":"libre","vue":true,"cible":"allie","parTour":1,"parCible":1,"relance":2,"relanceInitiale":0,"plafondPose":0,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"allies","effets":[{"type":"bouclier","valeur":24,"tours":2,"couchesMax":1}],"texte":"Un bouillon qui tient au corps : il encaisse les coups à la place d'un allié, d'un de tes légumes ou de toi-même.","change":""},{"id":"legumancien.bouillon-d-onze-heures","classe":"legumancien","emplacement":5,"declinaisonDe":"legumancien.bouillon-de-legumes","niveau":34,"nom":"Bouillon d'onze heures","element":"E","cm":3,"rayon":{"min":2,"max":5,"modifiable":true},"lancer":"libre","vue":true,"cible":"ennemi","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"E","min":13,"max":17,"maitre":[16,21]},{"type":"retire","quoi":"pas","n":1}],"texte":"Le bouillon d'onze heures, celui qu'on sert pour empoisonner : il pèse sur l'estomac, et la cible perd 1 Pas.","change":"Le bouillon qui protège devient le bouillon empoisonné de l'expression : plus de bouclier pour un allié, mais des dégâts Eaudace sur un ennemi, qui perd 1 Pas."},{"id":"legumancien.puree-de-pois","classe":"legumancien","emplacement":6,"declinaisonDe":null,"niveau":41,"nom":"Purée de pois","element":"E","cm":3,"rayon":{"min":2,"max":5,"modifiable":false},"lancer":"libre","vue":false,"cible":"case","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"rond","taille":1,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"E","min":11,"max":14,"maitre":[14,18]},{"type":"etat","etat":"ramolli","tours":1,"couches":1}],"texte":"Une averse de petits pois tombe du ciel, par-dessus les obstacles, et s'écrase en purée sous les pieds : les ennemis touchés sont ramollis et pataugent.","change":""},{"id":"legumancien.pile-pois","classe":"legumancien","emplacement":6,"declinaisonDe":"legumancien.puree-de-pois","niveau":49,"nom":"Pile-pois","element":"C","cm":2,"rayon":{"min":2,"max":7,"modifiable":true},"lancer":"libre","vue":true,"cible":"ennemi","parTour":3,"parCible":2,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"C","min":10,"max":13,"maitre":[13,16]},{"type":"si","condition":"cibleTombe","effets":[{"type":"gainCM","n":1,"qui":"soi"}]}],"texte":"Un petit pois chargé comme une pile, qui tombe pile poil. S'il fait tomber la cible, la charge te revient : 1 coup de main de plus.","change":"La purée de pois en zone devient un seul pois chargé comme une pile : une seule cible, plus loin et moins cher, en Éclair, et 1 coup de main rendu si la cible tombe."},{"id":"legumancien.aigrette-de-pissenlit","classe":"legumancien","emplacement":7,"declinaisonDe":null,"niveau":57,"nom":"Aigrette de pissenlit","element":"S","cm":3,"rayon":{"min":2,"max":6,"modifiable":true},"lancer":"libre","vue":true,"cible":"case","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"rond","taille":2,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"S","min":11,"max":14,"maitre":[14,18]}],"texte":"Tu souffles sur l'aigrette : les graines s'envolent et piquent tous les ennemis d'une large zone.","change":""},{"id":"legumancien.dent-de-lion","classe":"legumancien","emplacement":7,"declinaisonDe":"legumancien.aigrette-de-pissenlit","niveau":65,"nom":"Dent-de-lion","element":"T","cm":3,"rayon":{"min":1,"max":4,"modifiable":false},"lancer":"libre","vue":false,"cible":"case","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"travers","taille":1,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"T","min":12,"max":15,"maitre":[15,19]}],"texte":"Le pissenlit, qu'on appelle aussi dent-de-lion, montre les dents : une mâchoire sort du sol et mord 3 cases côte à côte, en travers face à toi. Elle mord par en dessous : pas besoin de voir la cible.","change":"Le pissenlit ne s'envole plus : sous son autre nom, dent-de-lion, il mord depuis le sol en Terroir, sur 3 cases côte à côte au lieu d'un grand rond, de plus près et sans avoir besoin de vue."},{"id":"legumancien.citrouille-de-garde","classe":"legumancien","emplacement":8,"declinaisonDe":null,"niveau":73,"nom":"Citrouille de garde","element":"N","cm":4,"rayon":{"min":1,"max":2,"modifiable":false},"lancer":"libre","vue":true,"cible":"caseLibre","parTour":1,"parCible":0,"relance":4,"relanceInitiale":1,"plafondPose":0,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"invoque","commis":{"nom":"Citrouille de garde","victuailles":120,"cm":3,"pas":2,"ouverture":0,"rideau":20,"fauxFuyant":0,"comportement":"colle","sorts":[{"id":"legumancien.vrille-de-courge","classe":"legumancien","declinaisonDe":null,"niveau":73,"nom":"Vrille de courge","element":"N","cm":2,"rayon":{"min":2,"max":4,"modifiable":false},"lancer":"libre","vue":true,"cible":"ennemi","parTour":1,"parCible":1,"relance":2,"relanceInitiale":0,"plafondPose":0,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"attire","cases":2}],"texte":"La courge lance une vrille, une tige qui s'enroule : elle attrape l'ennemi et le tire contre elle, de 2 cases.","change":""}]}}],"texte":"Une grosse citrouille sort de terre tout de suite et se poste devant toi. Elle attire un ennemi contre elle et le retient : avec elle, personne ne passe.","change":""},{"id":"legumancien.citrouille-lanterne","classe":"legumancien","emplacement":8,"declinaisonDe":"legumancien.citrouille-de-garde","niveau":81,"nom":"Citrouille-lanterne","element":"F","cm":4,"rayon":{"min":1,"max":3,"modifiable":false},"lancer":"libre","vue":false,"cible":"caseLibre","parTour":1,"parCible":0,"relance":3,"relanceInitiale":0,"plafondPose":1,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"pose","quoi":"ustensile","nom":"Citrouille-lanterne","victuailles":60,"tours":3,"zone":{"forme":"rond","taille":1,"tailleMin":1,"baisse":false},"touche":"ennemis","maitre":10,"effets":[{"type":"degats","element":"F","min":10,"max":13,"maitre":[13,16]}]}],"texte":"Une citrouille creusée, une bougie dedans : posée au sol, elle brûle les ennemis à côté d'elle au début de chacun de tes tours. Une seule à la fois.","change":"La citrouille ne garde plus : posée comme une lanterne pour 3 tours, elle ne bouge pas et ne prend pas de place de Commis, mais brûle en Flambée les ennemis à côté d'elle ; on peut la casser."},{"id":"legumancien.radis-actif","classe":"legumancien","emplacement":9,"declinaisonDe":null,"niveau":88,"nom":"Radis-actif","element":"C","cm":3,"rayon":{"min":2,"max":5,"modifiable":true},"lancer":"libre","vue":true,"cible":"ennemi","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"C","min":14,"max":18,"maitre":[18,23]},{"type":"rebond","fois":2,"rayon":2,"part":50}],"texte":"Un radis radioactif : son éclair saute d'un ennemi à l'autre, deux fois.","change":""},{"id":"legumancien.radis-ateur","classe":"legumancien","emplacement":9,"declinaisonDe":"legumancien.radis-actif","niveau":96,"nom":"Radis-ateur","element":"F","cm":3,"rayon":{"min":0,"max":5,"modifiable":false},"lancer":"libre","vue":true,"cible":"allie","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"rond","taille":1,"tailleMin":1,"baisse":false},"touche":"ennemis","effets":[{"type":"degats","element":"F","min":13,"max":16,"maitre":[16,20]},{"type":"etat","etat":"brule","tours":2,"couches":1}],"texte":"Tu vises un allié, un de tes légumes de préférence : il chauffe comme un radiateur et brûle les ennemis à côté de lui.","change":"Le radis ne rebondit plus : tu vises un allié, un de tes légumes ou toi-même, qui chauffe comme un radiateur et brûle en Flambée tous les ennemis à côté de lui."},{"id":"legumancien.racines-nouees","classe":"legumancien","emplacement":10,"declinaisonDe":null,"niveau":104,"nom":"Racines nouées","element":"E","cm":3,"rayon":{"min":1,"max":4,"modifiable":true},"lancer":"libre","vue":true,"cible":"ennemi","parTour":1,"parCible":1,"relance":3,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"E","min":14,"max":17,"maitre":[18,21]},{"type":"etat","etat":"enracine","tours":2,"couches":1}],"texte":"Des racines gorgées d'eau sortent du sol et se nouent aux chevilles : la cible ne marche plus pendant 2 tours. Il faut ensuite un tour pour refaire un nœud pareil : la cible a toujours un tour de répit.","change":""},{"id":"legumancien.racine-carree","classe":"legumancien","emplacement":10,"declinaisonDe":"legumancien.racines-nouees","niveau":112,"nom":"Racine carrée","element":"T","cm":4,"rayon":{"min":2,"max":5,"modifiable":false},"lancer":"libre","vue":false,"cible":"case","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"carre","taille":1,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"T","min":16,"max":20,"maitre":[20,25]},{"type":"pousse","cases":1}],"texte":"La racine carrée, version potager : des racines jaillissent sur un carré de 3 cases sur 3 et repoussent les ennemis touchés loin du centre.","change":"Les racines ne tiennent plus une cible : elles jaillissent du sol sur un carré de 3 cases sur 3, en Terroir, sans besoin de vue, et repoussent d'une case au lieu d'enraciner."},{"id":"legumancien.oignon-larmoyant","classe":"legumancien","emplacement":11,"declinaisonDe":null,"niveau":120,"nom":"Oignon larmoyant","element":"E","cm":3,"rayon":{"min":2,"max":5,"modifiable":true},"lancer":"libre","vue":true,"cible":"ennemi","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"E","min":14,"max":18,"maitre":[18,23]},{"type":"etat","etat":"ramolli","tours":2,"couches":1}],"texte":"Un oignon qui fait pleurer : les yeux pleins de larmes, la cible avance à tâtons. Elle est ramollie pendant 2 tours ; un deuxième oignon le tour suivant, et elle perd 2 Pas.","change":""},{"id":"legumancien.en-rang-d-oignons","classe":"legumancien","emplacement":11,"declinaisonDe":"legumancien.oignon-larmoyant","niveau":128,"nom":"En rang d'oignons","element":"S","cm":4,"rayon":{"min":1,"max":4,"modifiable":true},"lancer":"ligne","vue":true,"cible":"case","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"ligne","taille":3,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"S","min":17,"max":21,"maitre":[21,26]},{"type":"attire","cases":1}],"texte":"Un coup de vent prend toute la rangée, et chacun avance d'une case vers toi : les voilà en rang d'oignons.","change":"L'oignon ne fait plus pleurer une seule cible : un coup de vent frappe toute une ligne de 4 cases en Soufflé et attire chaque ennemi d'une case vers toi."},{"id":"legumancien.chou-fleur-carnivore","classe":"legumancien","emplacement":12,"declinaisonDe":null,"niveau":135,"nom":"Chou-fleur carnivore","element":"F","cm":4,"rayon":{"min":1,"max":3,"modifiable":false},"lancer":"libre","vue":false,"cible":"caseLibre","parTour":1,"parCible":0,"relance":4,"relanceInitiale":0,"plafondPose":1,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"