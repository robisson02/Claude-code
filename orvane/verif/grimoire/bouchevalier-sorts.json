[{"id":"bouchevalier.tranche-de-vie","classe":"bouchevalier","emplacement":1,"declinaisonDe":null,"niveau":1,"nom":"Tranche de vie","element":"T","cm":3,"rayon":{"min":1,"max":1,"modifiable":false},"lancer":"libre","vue":true,"cible":"ennemi","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"T","min":16,"max":20,"maitre":[20,25]},{"type":"entame","part":25,"tours":2}],"texte":"Une tranche nette, au contact. C'est le Tranchant : pendant 2 tours, un quart des dégâts que la cible reçoit ne pourra plus être soigné de tout le combat. Une tranche de vie, au sens propre.","change":""},{"id":"bouchevalier.coupe-vent","classe":"bouchevalier","emplacement":1,"declinaisonDe":"bouchevalier.tranche-de-vie","niveau":3,"nom":"Coupe-vent","element":"S","cm":2,"rayon":{"min":1,"max":1,"modifiable":false},"lancer":"libre","vue":true,"cible":"case","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"travers","taille":1,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"S","min":8,"max":11,"maitre":[10,14]},{"type":"si","condition":"auContact","effets":[{"type":"entame","part":25,"tours":2}]}],"texte":"Un grand revers fend l'air devant toi : le vent coupe, la lame aussi.","change":"Au lieu d'une seule tranche, un revers en Soufflé balaie les 3 cases devant toi, pour 2 coups de main. Seul l'ennemi collé à toi est entamé."},{"id":"bouchevalier.croc-de-boucher","classe":"bouchevalier","emplacement":2,"declinaisonDe":null,"niveau":1,"nom":"Croc de boucher","element":"S","cm":2,"rayon":{"min":2,"max":3,"modifiable":false},"lancer":"ligne","vue":true,"cible":"ennemi","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"S","min":7,"max":9,"maitre":[9,11]},{"type":"attire","cases":3}],"texte":"Le croc accroche l'ennemi à 2 ou 3 cases et le tire jusqu'à toi. Collé à toi, il est pris dans ton Rideau. Un croc ne tient qu'une pièce à la fois : 2 lancers par tour, 1 par cible.","change":""},{"id":"bouchevalier.lancer-de-hachoir","classe":"bouchevalier","emplacement":2,"declinaisonDe":"bouchevalier.croc-de-boucher","niveau":5,"nom":"Lancer de hachoir","element":"C","cm":3,"rayon":{"min":1,"max":5,"modifiable":true},"lancer":"ligne","vue":true,"cible":"ennemi","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"C","min":12,"max":15,"maitre":[15,19]},{"type":"rebond","fois":1,"rayon":2,"part":50}],"texte":"Le hachoir part tout droit, frappe, puis ricoche sur l'ennemi le plus proche.","change":"Le croc n'attire plus : tu lances le hachoir, plus loin et plus fort, en Éclair. Il ricoche sur un deuxième ennemi à 2 cases ou moins, pour la moitié des dégâts."},{"id":"bouchevalier.tomber-sur-un-os","classe":"bouchevalier","emplacement":3,"declinaisonDe":null,"niveau":1,"nom":"Tomber sur un os","element":"N","cm":2,"rayon":{"min":0,"max":0,"modifiable":false},"lancer":"libre","vue":false,"cible":"soi","parTour":1,"parCible":0,"relance":3,"relanceInitiale":0,"plafondPose":0,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"allies","effets":[{"type":"bouclier","valeur":17,"tours":2,"couchesMax":1},{"type":"bonus","carac":"rideau","valeur":10,"tours":3,"qui":"soi"}],"texte":"Qui vient te chercher tombe sur un os : bouclier de 17 pendant 2 tours, et +10 Rideau pendant 3 tours. Une fois collé à toi, on ne repart plus comme ça : l'os revient quand le Rideau retombe.","change":""},{"id":"bouchevalier.os-a-ronger","classe":"bouchevalier","emplacement":3,"declinaisonDe":"bouchevalier.tomber-sur-un-os","niveau":7,"nom":"Os à ronger","element":"T","cm":3,"rayon":{"min":2,"max":4,"modifiable":true},"lancer":"libre","vue":false,"cible":"ennemi","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"T","min":15,"max":19,"maitre":[19,24]}],"texte":"Un os lancé en cloche, par-dessus les obstacles : de quoi l'occuper un moment.","change":"Tu ne gardes plus l'os pour toi : tu le lances en cloche, sans ligne de vue, sur un ennemi entre 2 et 4 cases, en Terroir."},{"id":"bouchevalier.barbecue","classe":"bouchevalier","emplacement":4,"declinaisonDe":null,"niveau":10,"nom":"Barbecue","element":"F","cm":3,"rayon":{"min":1,"max":3,"modifiable":false},"lancer":"libre","vue":true,"cible":"case","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":15,"zone":{"forme":"carre","taille":1,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"F","min":9,"max":12,"maitre":[11,15]},{"type":"etat","etat":"brule","tours":2,"couches":1}],"texte":"Tu allumes le gril, un carré de 3 cases sur 3 : tout ce qui est dessus grille, et brûle encore 2 tours.","change":""},{"id":"bouchevalier.barbecue-a-l-eau","classe":"bouchevalier","emplacement":4,"declinaisonDe":"bouchevalier.barbecue","niveau":18,"nom":"Barbecue à l'eau","element":"E","cm":3,"rayon":{"min":1,"max":4,"modifiable":true},"lancer":"ligne","vue":true,"cible":"ennemi","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"E","min":14,"max":17,"maitre":[18,21]},{"type":"etat","etat":"ramolli","tours":1,"couches":1}],"texte":"Le barbecue tombe à l'eau : la braise est noyée, et le jet trempe la cible jusqu'aux os.","change":"Le gril en zone devient un jet d'eau en ligne : une seule cible, plus fort, en Eaudace, et elle perd 1 Pas (ramollie)."},{"id":"bouchevalier.saute-mouton","classe":"bouchevalier","emplacement":5,"declinaisonDe":null,"niveau":26,"nom":"Saute-mouton","element":"N","cm":2,"rayon":{"min":1,"max":4,"modifiable":false},"lancer":"libre","vue":true,"cible":"allie","parTour":1,"parCible":0,"relance":2,"relanceInitiale":0,"plafondPose":0,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"allies","effets":[{"type":"echange"},{"type":"bonus","carac":"conservation","valeur":15,"tours":2,"qui":"soi"}],"texte":"Au saute-mouton, tu passes par-dessus le copain et tu prends sa place, avec les coups qui allaient avec : +15 % de Conservation pendant 2 tours. C'est d'abord un déplacement : il revient au bout de 2 tours, comme un saut.","change":""},{"id":"bouchevalier.mouton-statique","classe":"bouchevalier","emplacement":5,"declinaisonDe":"bouchevalier.saute-mouton","niveau":34,"nom":"Mouton statique","element":"C","cm":2,"rayon":{"min":0,"max":0,"modifiable":false},"lancer":"libre","vue":false,"cible":"soi","parTour":1,"parCible":0,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"rond","taille":1,"tailleMin":1,"baisse":false},"touche":"ennemis","effets":[{"type":"degats","element":"C","min":7,"max":10,"maitre":[9,13]},{"type":"rebond","fois":1,"rayon":2,"part":50}],"texte":"Le mouton ne saute plus : il reste là, et sa laine chargée pique tous ceux qui le collent. Puis l'étincelle saute sur un voisin.","change":"Plus d'échange : tu restes statique, et ta laine chargée frappe en Éclair les ennemis des 4 cases collées à toi, puis l'étincelle saute sur un autre ennemi à 2 cases, à moitié de sa force. Une fois par tour, car elle touche tous tes voisins."},{"id":"bouchevalier.mise-en-barquette","classe":"bouchevalier","emplacement":6,"declinaisonDe":null,"niveau":41,"nom":"Mise en barquette","element":"N","cm":2,"rayon":{"min":1,"max":2,"modifiable":false},"lancer":"libre","vue":true,"cible":"allie","parTour":1,"parCible":1,"relance":2,"relanceInitiale":0,"plafondPose":0,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"allies","effets":[{"type":"bouclier","valeur":25,"tours":2,"couchesMax":1},{"type":"etat","etat":"glissant","tours":1,"couches":1}],"texte":"L'allié est mis en barquette, sous film : bouclier de 25. Et le film glisse si bien qu'à son prochain tour, il quitte le contact sans rien perdre.","change":""},{"id":"bouchevalier.mise-sous-vide","classe":"bouchevalier","emplacement":6,"declinaisonDe":"bouchevalier.mise-en-barquette","niveau":49,"nom":"Mise sous vide","element":"S","cm":3,"rayon":{"min":1,"max":3,"modifiable":false},"lancer":"libre","vue":true,"cible":"ennemi","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"S","min":12,"max":15,"maitre":[15,19]},{"type":"attire","cases":2}],"texte":"Tu fais le vide d'un coup : la cible est aspirée de 2 cases vers toi, emballée.","change":"Tu emballes l'ennemi au lieu de l'allié : petits dégâts Soufflé, et le vide l'aspire de 2 cases vers toi."},{"id":"bouchevalier.marinade","classe":"bouchevalier","emplacement":7,"declinaisonDe":null,"niveau":57,"nom":"Marinade","element":"E","cm":3,"rayon":{"min":1,"max":4,"modifiable":true},"lancer":"libre","vue":true,"cible":"ennemi","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"E","min":12,"max":16,"maitre":[15,20]},{"type":"etat","etat":"attendri","tours":2,"couches":1},{"type":"etat","etat":"ramolli","tours":1,"couches":1}],"texte":"Dans la marinade, la viande ramollit et s'attendrit. L'ennemi aussi : −1 Pas, et −10 % de Conservation pendant 2 tours.","change":""},{"id":"bouchevalier.laisser-mariner","classe":"bouchevalier","emplacement":7,"declinaisonDe":"bouchevalier.marinade","niveau":65,"nom":"Laisser mariner","element":"E","cm":3,"rayon":{"min":1,"max":4,"modifiable":false},"lancer":"libre","vue":true,"cible":"case","parTour":1,"parCible":0,"relance":0,"relanceInitiale":0,"plafondPose":2,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"pose","quoi":"nappe","tours":2,"declenche":"debut","zone":{"forme":"rond","taille":1,"tailleMin":0,"baisse":false},"touche":"ennemis","maitre":5,"effets":[{"type":"degats","element":"E","min":11,"max":13,"maitre":[14,16]},{"type":"etat","etat":"ramolli","tours":1,"couches":1},{"type":"etat","etat":"attendri","tours":2,"couches":1}]}],"texte":"Tu verses la marinade au sol, et tu laisses mariner : qui commence son tour dedans y trempe, ramollit et s'attendrit.","change":"La marinade ne vise plus une cible : elle reste au sol 2 tours, sur 5 cases. Chaque ennemi qui commence son tour dedans prend des dégâts Eaudace, perd 1 Pas et s'attendrit. Une flaque par tour, deux au sol au plus, car elle dure."},{"id":"bouchevalier.attendrisseur","classe":"bouchevalier","emplacement":8,"declinaisonDe":null,"niveau":73,"nom":"Attendrisseur","element":"F","cm":3,"rayon":{"min":1,"max":1,"modifiable":false},"lancer":"libre","vue":true,"cible":"ennemi","parTour":1,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":20,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"F","min":15,"max":19,"maitre":[19,24]},{"type":"etat","etat":"attendri","tours":2,"couches":1},{"type":"entame","part":25,"tours":2}],"texte":"Le maillet à pointes tombe de tout son poids. La cible est entamée, et attendrie : elle craint davantage les coups. Un seul coup de maillet par tour : il est lourd.","change":""},{"id":"bouchevalier.attendrissement","classe":"bouchevalier","emplacement":8,"declinaisonDe":"bouchevalier.attendrisseur","niveau":81,"nom":"Attendrissement","element":"N","cm":3,"rayon":{"min":0,"max":0,"modifiable":false},"lancer":"libre","vue":false,"cible":"soi","parTour":1,"parCible":0,"relance":3,"relanceInitiale":0,"plafondPose":0,"maitre":0,"zone":{"forme":"rond","taille":2,"tailleMin":1,"baisse":false},"touche":"ennemis","effets":[{"type":"bonus","carac":"degatsPct","valeur":-10,"tours":2,"qui":"cible"},{"type":"etat","etat":"attendri","tours":2,"couches":1}],"texte":"Les ennemis autour de toi sont tout attendris : ils n'ont plus le cœur à frapper fort, ni à encaisser.","change":"La grosse frappe au contact devient une protection : pendant 2 tours, les ennemis à 2 cases ou moins font 10 % de dégâts en moins, et ils sont attendris (−10 % de Conservation)."},{"id":"bouchevalier.billot","classe":"bouchevalier","emplacement":9,"declinaisonDe":null,"niveau":88,"nom":"Billot","element":"N","cm":2,"rayon":{"min":0,"max":0,"modifiable":false},"lancer":"libre","vue":false,"cible":"soi","parTour":1,"parCible":0,"relance":3,"relanceInitiale":0,"plafondPose":0,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"allies","effets":[{"type":"bonus","carac":"conservation","valeur":25,"tours":2,"qui":"soi"},{"type":"etat","etat":"plante","tours":2,"couches":1}],"texte":"Planté comme un billot : +25 % de Conservation, et rien ne te fait bouger de force pendant 2 tours.","change":""},{"id":"bouchevalier.sur-le-billot","classe":"bouchevalier","emplacement":9,"declinaisonDe":"bouchevalier.billot","niveau":96,"nom":"Sur le billot","element":"T","cm":4,"rayon":{"min":1,"max":1,"modifiable":false},"lancer":"libre","vue":true,"cible":"ennemi","parTour":1,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"T","min":20,"max":25,"maitre":[25,31]},{"type":"entame","part":25,"tours":2},{"type":"bonus","carac":"rideau","valeur":10,"tours":2,"qui":"soi"}],"texte":"Tu poses l'ennemi sur le billot : il est entamé, et il ne s'en va plus si facilement.","change":"Le billot ne te protège plus, tu y poses l'ennemi : une grosse frappe Terroir au contact, avec le Tranchant, et +10 Rideau pendant 2 tours pour le garder."},{"id":"bouchevalier.coup-de-jarret","classe":"bouchevalier","emplacement":10,"declinaisonDe":null,"niveau":104,"nom":"Coup de jarret","element":"T","cm":3,"rayon":{"min":1,"max":1,"modifiable":false},"lancer":"libre","vue":true,"cible":"ennemi","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"T","min":16,"max":20,"maitre":[20,25]},{"type":"entame","part":25,"tours":2},{"type":"pousse","cases":2}],"texte":"Un coup sec dans le jarret, et l'ennemi recule de 2 cases. S'il heurte un obstacle, il s'écrase.","change":""},{"id":"bouchevalier.jarretiere","classe":"bouchevalier","emplacement":10,"declinaisonDe":"bouchevalier.coup-de-jarret","niveau":112,"nom":"Jarretière","element":"N","cm":2,"rayon":{"min":2,"max":6,"modifiable":true},"lancer":"libre","vue":true,"cible":"allie","parTour":1,"parCible":0,"relance":2,"relanceInitiale":0,"plafondPose":0,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"allies","effets":[{"type":"ramene","cases":5}],"texte":"Honni soit qui mal y pense : la jarretière, élastique, ramène un allié en danger jusqu'à toi.","change":"Tu ne repousses plus un ennemi : la jarretière ramène un allié vers toi, de 5 cases au plus, sans dégâts, pour le sauver."},{"id":"bouchevalier.tournedos","classe":"bouchevalier","emplacement":11,"declinaisonDe":null,"niveau":120,"nom":"Tournedos","element":"S","cm":3,"rayon":{"min":1,"max":1,"modifiable":false},"lancer":"libre","vue":true,"cible":"ennemi","parTour":1,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"S","min":17,"max":21,"maitre":[21,26]},{"type":"entame","part":25,"tours":2},{"type":"dans-le-dos"}],"texte":"Tu frappes la cible, puis tu passes dans son dos : pour te faire face, elle doit tourner le dos à ses amis. Un vrai tournedos. Une fois par tour seulement, car tu changes de place.","change":""},{"id":"bouchevalier.tourne-broche","classe":"bouchevalier","emplacement":11,"declinaisonDe":"bouchevalier.tournedos","niveau":128,"nom":"Tourne-broche","element":"F","cm":4,"rayon":{"min":0,"max":0,"modifiable":false},"lancer":"libre","vue":false,"cible":"soi","parTour":1,"parCible":0,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":15,"zone":{"forme":"carre","taille":1,"tailleMin":1,"baisse":false},"touche":"ennemis","effets":[{"type":"degats","element":"F","min":15,"max":19,"maitre":[19,24]},{"type":"etat","etat":"brule","tours":2,"couches":1}],"texte":"Tu tournes sur toi-même comme une broche : tout ce qui t'entoure rôtit.","change":"Tu ne passes plus dans le dos : tu tournes sur place et tu brûles en Flambée les ennemis des 8 cases autour de toi, diagonales comprises. Une fois par tour, car il touche tous tes voisins."},{"id":"bouchevalier.cote-de-mailles","classe":"bouchevalier","emplacement":12,"declinaisonDe":null,"niveau":135,"nom":"Côte de mailles","element":"N","cm":3,"rayon":{"min":0,"max":0,"modifiable":false},"lancer":"libre","vue":false,"cible":"soi","parTour":1,"parCible":0,"relance":3,"relanceInitiale":0,"plafondPose":0,"maitre":0,"zone":{"forme":"rond","taille":1,"tailleMin":0,"baisse":false},"touche":"allies","effets":[{"type":"bonus","carac":"conservation","valeur":20,"tours":2,"qui":"cible"}],"texte":"Une côte de mailles pour tout le monde : toi et les alliés collés à toi gagnez +20 % de Conservation pendant 2 tours.","change":""},{"id":"bouchevalier.maille-a-partir","classe":"bouchevalier","emplacement":12,"declinaisonDe":"bouchevalier.cote-de-mailles","niveau":143,"nom":"Maille à partir","element":"S","cm":4,"rayon":{"min":0,"max":0,"modifiable":false},"lancer":"libre","vue":false,"cible":"soi","parTour":1,"parCible":0,"relance":2,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"rond","taille":3,"tailleMin":2,"baisse":false},"touche":"ennemis","effets":[{"type":"degats","element":"S","min":11,"max":14,"maitre":[14,18]},{"type":"attire","cases":2}],"texte":"Tu as maille à partir avec tout le monde : qu'ils viennent donc te chercher.","change":"Au lieu de rendre tes alliés plus solides, tu cherches la bagarre : les ennemis à 2 ou 3 cases prennent des dégâts Soufflé et sont attirés de 2 cases vers toi. Une fois par tour, avec une relance de 2, car il déplace tout le monde."},{"id":"bouchevalier.fusil-a-aiguiser","classe":"bouchevalier","emplacement":13,"declinaisonDe":null,"niveau":151,"nom":"Fusil à aiguiser","element":"N","cm":2,"rayon":{"min":0,"max":0,"modifiable":false},"lancer":"libre","vue":false,"cible":"soi","parTour":1,"parCible":0,"relance":3,"relanceInitiale":0,"plafondPose":0,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"allies","effets":[{"type":"bonus","carac":"coupDeMaitre","valeur":20,"tours":2,"qui":"soi"}],"texte":"Quelques passes sur le fusil, et la lame est prête : +20 % de Coup de maître pendant 2 tours. Ton couperet n'en coupe que mieux.","change":""},{"id":"bouchevalier.fine-lame","classe":"bouchevalier","emplacement":13,"declinaisonDe":"bouchevalier.fusil-a-aiguiser","niveau":159,"nom":"Fine lame","element":"C","cm":3,"rayon":{"min":2,"max":5,"modifiable":true},"lancer":"libre","vue":true,"cible":"ennemi","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"C","min":15,"max":19,"maitre":[19,24]},{"type":"retire","quoi":"cm","n":1}],"texte":"Bien aiguisée, la lame file comme l'éclair jusqu'à la cible et lui coupe un coup de main.","change":"Le fusil ne prépare plus les coups : la lame frappe à distance, en Éclair, et la cible perd 1 coup de main."},{"id":"bouchevalier.piece-du-boucher","classe":"bouchevalier","emplacement":14,"declinaisonDe":null,"niveau":167,"nom":"Pièce du boucher","element":"T","cm":5,"rayon":{"min":1,"max":2,"modifiable":false},"lancer":"libre","vue":true,"cible":"ennemi","parTour":1,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"croix","taille":1,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"T","min":23,"max":28,"maitre":[29,35]},{"type":"pousse","cases":1},{"type":"si","condition":"auContact","effets":[{"type":"entame","part":25,"tours":2}]}],"texte":"La grosse pièce s'abat sur la cible et sur les 4 cases autour. Tous reculent d'une case, et ceux qui sont collés à toi sont entamés.","change":""},{"id":"bouchevalier.piece-de-resistance","classe":"bouchevalier","emplacement":14,"declinaisonDe":"bouchevalier.piece-du-boucher","niveau":175,"nom":"Pièce de résistance","element":"F","cm":4,"rayon":{"min":0,"max":0,"modifiable":false},"lancer":"libre","vue":false,"cible":"soi","parTour":1,"parCible":0,"relance":2,"relanceInitiale":0,"plafondPose":1,"maitre":0,"zone":{"forme":"rond","taille":1,"tailleMin":1,"baisse":false},"touche":"ennemis","effets":[{"type":"pose","quoi":"nappe","tours":2,"declenche":"fin","zone":{"forme":"rond","taille":1,"tailleMin":1,"baisse":false},"touche":"ennemis","maitre":10,"effets":[{"type":"degats","element":"F","min":14,"max":17,"maitre":[18,21]}]}],"texte":"Tu deviens la pièce de résistance du repas, et tu chauffes comme la résistance d'un four : l'ennemi qui finit son tour collé à toi se brûle.","change":"La grosse pièce ne s'abat plus sur l'ennemi : pendant 2 tours, les 4 cases autour de toi brûlent en Flambée l'ennemi qui y finit son tour, et ton Rideau le retient là. Une seule à la fois, relance de 2 : il n'y a qu'une pièce de résistance."},{"id":"bouchevalier.saignant-ou-a-point","classe":"bouchevalier","emplacement":15,"declinaisonDe":null,"niveau":182,"nom":"Saignant ou à point","element":"F","cm":4,"rayon":{"min":1,"max":3,"modifiable":false},"lancer":"libre","vue":true,"cible":"ennemi","parTour":1,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":20,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"F","min":22,"max":26,"maitre":[28,33]},{"type":"si","condition":"cibleBlessee","effets":[{"type":"degats","element":"F","min":11,"max":13,"maitre":[14,16]}]}],"texte":"Plus la cible est blessée, plus ça cuit : sous la moitié de sa vie (ses Victuailles), elle prend un supplément.","change":""},{"id":"bouchevalier.cuisson-bleue","classe":"bouchevalier","emplacement":15,"declinaisonDe":"bouchevalier.saignant-ou-a-point","niveau":190,"nom":"Cuisson bleue","element":"E","cm":4,"rayon":{"min":2,"max":5,"modifiable":true},"lancer":"libre","vue":true,"cible":"ennemi","parTour":1,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"E","min":20,"max":24,"maitre":[25,30]},{"type":"retire","quoi":"pas","n":2}],"texte":"Une cuisson bleue : à peine saisie. La cible, saisie, perd 2 Pas.","change":"La finition de près devient une ouverture de loin : plus de supplément sur les blessés, mais la cible est saisie, en Eaudace, et perd 2 Pas."},{"id":"bouchevalier.chef-d-oeuvre-l-etal-royal","classe":"bouchevalier","emplacement":16,"declinaisonDe":null,"niveau":200,"nom":"Chef-d'œuvre : l'Étal royal","element":"E","cm":7,"rayon":{"min":0,"max":0,"modifiable":false},"lancer":"libre","vue":false,"cible":"soi","parTour":1,"parCible":0,"relance":5,"relanceInitiale":2,"plafondPose":1,"maitre":10,"zone":{"forme":"rond","taille":2,"tailleMin":1,"baisse":false},"touche":"ennemis","effets":[{"type":"degats","element":"E","min":34,"max":42,"maitre":[43,53]},{"type":"etat","etat":"ramolli","tours":1,"couches":2},{"type":"pose","quoi":"nappe","tours":1,"declenche":"debut","zone":{"forme":"rond","taille":2,"tailleMin":0,"baisse":false},"touche":"allies","maitre":0,"effets":[{"type":"bouclier","valeur":40,"tours":2,"couchesMax":1}]}],"texte":"Tu ouvres la chambre froide : le givre frappe les ennemis à 2 cases ou moins et les ralentit (−2 Pas). Les alliés qui commencent leur tour dans le froid, toi compris, se couvrent de givre : bouclier de 40.","change":""},{"id":"bouchevalier.chef-d-oeuvre-la-taille-royale","classe":"bouchevalier","emplacement":16,"declinaisonDe":"bouchevalier.chef-d-oeuvre-l-etal-royal","niveau":200,"nom":"Chef-d'œuvre : la Taille royale","element":"C","cm":7,"rayon":{"min":1,"max":1,"modifiable":false},"lancer":"ligne","vue":true,"cible":"case","parTour":1,"parCible":0,"relance":5,"relanceInitiale":2,"plafondPose":0,"maitre":15,"zone":{"forme":"ligne","taille":5,"tailleMin":0,"baisse":false},"touche":"ennemis","effets":[{"type":"degats","element":"C","min":38,"max":46,"maitre":[48,58]},{"type":"entame","part":25,"tours":2},{"type":"si","condition":"cibleTombe","effets":[{"type":"gainCM","n":1,"qui":"soi"}]}],"texte":"La taille royale : la coupe du boucher, et l'ancien impôt du roi. Un seul coup de couperet, rapide comme l'éclair, fend toute la ligne.","change":"Tu ne protèges plus autour de toi : un seul coup, en Éclair, fend une ligne de 6 cases et entame chaque ennemi. Si au moins un ennemi tombe, tu regagnes 1 coup de main."}]