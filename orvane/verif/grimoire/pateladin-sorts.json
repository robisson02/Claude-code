,"lancer":"libre","vue":false,"cible":"case","parTour":1,"parCible":0,"relance":3,"relanceInitiale":0,"plafondPose":2,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"allies","effets":[{"type":"pose","quoi":"nappe","tours":3,"declenche":"debut","zone":{"forme":"rond","taille":2,"tailleMin":0,"baisse":false},"touche":"allies","maitre":5,"effets":[{"type":"soin","min":10,"max":13,"maitre":[13,16]}]},{"type":"pose","quoi":"nappe","tours":3,"declenche":"debut","zone":{"forme":"rond","taille":2,"tailleMin":0,"baisse":false},"touche":"ennemis","maitre":0,"effets":[{"type":"etat","etat":"fume","tours":1,"couches":1}]}],"texte":"La fumée sacrée monte du fumoir : elle bénit les alliés et fait tousser les impies qui y commencent leur tour. Une seule à la fois : elle tient 3 tours, autant que sa relance.","change":""},{"id":"pateladin.pas-de-fumee-sans-feu","classe":"pateladin","emplacement":10,"declinaisonDe":"pateladin.fumee-sacree","niveau":112,"nom":"Pas de fumée sans feu","element":"F","cm":4,"rayon":{"min":1,"max":3,"modifiable":false},"lancer":"libre","vue":false,"cible":"case","parTour":1,"parCible":0,"relance":2,"relanceInitiale":0,"plafondPose":2,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"pose","quoi":"nappe","tours":2,"declenche":"debut","zone":{"forme":"rond","taille":1,"tailleMin":0,"baisse":false},"touche":"ennemis","maitre":10,"effets":[{"type":"degats","element":"F","min":12,"max":15,"maitre":[15,19]}]},{"type":"pose","quoi":"nappe","tours":2,"declenche":"debut","zone":{"forme":"rond","taille":1,"tailleMin":0,"baisse":false},"touche":"allies","maitre":5,"effets":[{"type":"soin","min":5,"max":7,"maitre":[6,9]}]}],"texte":"Il n'y a pas de fumée sans feu : celle-ci brûle les ennemis qui y commencent leur tour.","change":"La grande fumée de soutien devient une petite fumée d'attaque de 2 tours, qui brûle les ennemis à chaque début de tour et soigne moins ; une seule à la fois, relance 2, car elle dure 2 tours."},{"id":"pateladin.cervelas","classe":"pateladin","emplacement":11,"declinaisonDe":null,"niveau":120,"nom":"Cervelas","element":"C","cm":3,"rayon":{"min":1,"max":3,"modifiable":true},"lancer":"libre","vue":true,"cible":"ennemi","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"C","min":16,"max":20,"maitre":[20,25]},{"type":"retire","quoi":"cm","n":1}],"texte":"Un coup de cervelas sur la tête : la cible voit trente-six chandelles et perd un coup de main.","change":""},{"id":"pateladin.tempete-sous-un-cervelas","classe":"pateladin","emplacement":11,"declinaisonDe":"pateladin.cervelas","niveau":128,"nom":"Tempête sous un cervelas","element":"S","cm":4,"rayon":{"min":1,"max":4,"modifiable":true},"lancer":"libre","vue":true,"cible":"case","parTour":1,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"rond","taille":1,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"S","min":16,"max":20,"maitre":[20,25]},{"type":"bonus","carac":"fauxFuyant","valeur":-5,"tours":1,"qui":"cible"}],"texte":"Une tempête sous un cervelas : les ennemis, déboussolés, ne savent plus par où filer (−5 Faux-fuyant à leur prochain tour).","change":"La frappe sur une cible devient une tempête en rond, en Soufflé, plus chère ; au lieu d'un coup de main, les ennemis touchés perdent 5 Faux-fuyant pendant 1 tour : ils ont du mal à quitter le contact."},{"id":"pateladin.faire-le-boudin","classe":"pateladin","emplacement":12,"declinaisonDe":null,"niveau":135,"nom":"Faire le boudin","element":"N","cm":2,"rayon":{"min":0,"max":0,"modifiable":false},"lancer":"libre","vue":false,"cible":"soi","parTour":1,"parCible":0,"relance":3,"relanceInitiale":0,"plafondPose":1,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"