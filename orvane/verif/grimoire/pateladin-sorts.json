re.","change":""},{"id":"pateladin.poelee-de-lardons","classe":"pateladin","emplacement":13,"declinaisonDe":"pateladin.pluie-de-lardons","niveau":159,"nom":"Poêlée de lardons","element":"F","cm":4,"rayon":{"min":0,"max":0,"modifiable":false},"lancer":"libre","vue":false,"cible":"soi","parTour":1,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":15,"zone":{"forme":"rond","taille":2,"tailleMin":1,"baisse":false},"touche":"ennemis","effets":[{"type":"degats","element":"F","min":16,"max":19,"maitre":[20,24]},{"type":"etat","etat":"fume","tours":1,"couches":1}],"texte":"Des lardons fumés sautent dans la poêle : ça grésille tout autour, et la fumée fait tousser les ennemis touchés.","change":"Le tir qui rebondit devient une zone tout autour de soi, en Flambée ; les ennemis touchés sont Fumés 1 tour (−15 % de dégâts)."},{"id":"pateladin.jambonneau","classe":"pateladin","emplacement":14,"declinaisonDe":null,"niveau":167,"nom":"Jambonneau","element":"E","cm":5,"rayon":{"min":1,"max":1,"modifiable":false},"lancer":"libre","vue":true,"cible":"ennemi","parTour":1,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"E","min":28,"max":33,"maitre":[35,41]},{"type":"etat","etat":"ramolli","tours":1,"couches":1}],"texte":"Le jambonneau sort tout juste du bouillon : il cogne fort, et il ramollit.","change":""},{"id":"pateladin.jambon-de-pays","classe":"pateladin","emplacement":14,"declinaisonDe":"pateladin.jambonneau","niveau":175,"nom":"Jambon de pays","element":"T","cm":5,"rayon":{"min":1,"max":3,"modifiable":false},"lancer":"ligne","vue":true,"cible":"ennemi","parTour":1,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"T","min":26,"max":31,"maitre":[33,39]},{"type":"pousse","cases":