afondPose":0,"maitre":5,"zone":{"forme":"croix","taille":1,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"E","min":10,"max":12,"maitre":[13,15]},{"type":"etat","etat":"ramolli","tours":1,"couches":1}],"texte":"Un signe de croix à l'eau bénite : les ennemis traînent les pieds.","change":"Le tir sur une cible devient un signe de croix : une zone en croix, en Eaudace, qui ramollit les ennemis touchés (−1 Pas)."},{"id":"pateladin.jambondissement","classe":"pateladin","emplacement":5,"declinaisonDe":null,"niveau":26,"nom":"Jambondissement","element":"N","cm":2,"rayon":{"min":1,"max":3,"modifiable":false},"lancer":"libre","vue":true,"cible":"caseLibre","parTour":1,"parCible":0,"relance":2,"relanceInitiale":0,"plafondPose":2,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"allies","effets":[{"type":"bond"},{"type":"pose","quoi":"nappe","tours":1,"declenche":"debut","zone":{"forme":"rond","taille":1,"tailleMin":0,"baisse":false},"touche":"allies","maitre":5,"effets":[{"type":"soin","min":7,"max":9,"maitre":[9,11]}]},{"type":"pose","quoi":"nappe","tours":1,"declenche":"debut","zone":{"forme":"rond","taille":1,"tailleMin":0,"baisse":false},"touche":"ennemis","maitre":0,"effets":[{"type":"etat","etat":"fume","tours":1,"couches":1}]}],"texte":"Un bond de jambon pour voler au secours : il retombe dans un petit nuage de fumée, qui soigne les alliés autour de lui et fait tousser les ennemis au début de leur tour.","change":""},{"id":"pateladin.jambon-ricochet","classe":"pateladin","emplacement":5,"declinaisonDe":"pateladin.jambondissement","niveau":34,"nom":"Jambon-ricochet","element":"C","cm":2,"rayon":{"min":1,"max":4,"modifiable":false},"lancer":"ligne","vue":true,"cible":"ennemi","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"C","min":8,"max":10,"maitre":[10,13]},{"type":"rebond","fois":2,"rayon":2,"part":50}],"texte":"Le jambon ricoche d'un ennemi à l'autre, vif comme l'éclair.","change":"Le bond devient un tir Éclair en ligne qui rebondit deux fois à moitié de sa force ; 2 par tour seulement, à cause des rebonds."},{"id":"pateladin.terrine","classe":"pateladin","emplacement":6,"declinaisonDe":null,"niveau":41,"nom":"Terrine","element":"E","cm":3,"rayon":{"min":1,"max":3,"modifiable":false},"lancer":"libre","vue":true,"cible":"ennemi","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"E","min":12,"max":16,"maitre":[15,20]},{"type":"etat","etat":"enracine","tours":1,"couches":1}],"texte":"Cuite au bain-marie et bien tassée : la cible ne bouge plus de sa terrine.","change":""},{"id":"pateladin.prise-de-terrine","classe":"pateladin","emplacement":6,"declinaisonDe":"pateladin.terrine","niveau":49,"nom":"Prise de terrine","element":"T","cm":3,"rayon":{"min":1,"max":4,"modifiable":false},"lancer":"libre","vue":false,"cible":"ennemi","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"T","min":16,"max":20,"maitre":[20,25]}],"texte":"Comme une prise de terre : le coup passe sous la terre et ressort sous la cible, même derrière un mur.","change":"On n'enferme plus la cible : le coup, en Terroir et plus fort, passe sous la terre et frappe sans ligne de vue jusqu'à 4 cases."},{"id":"pateladin.pate-en-croute","classe":"pateladin","emplacement":7,"declinaisonDe":null,"niveau":57,"nom":"Pâté en croûte","element":"N","cm":3,"rayon":{"min":0,"max":3,"modifiable":false},"lancer":"libre","vue":true,"cible":"allie","parTour":1,"parCible":1,"relance":2,"relanceInitiale":0,"plafondPose":0,"maitre":0,"zone":{"forme":"case","taille