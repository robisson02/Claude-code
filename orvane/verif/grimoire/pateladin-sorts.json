[{"id":"pateladin.coup-de-saucisson","classe":"pateladin","emplacement":1,"declinaisonDe":null,"niveau":1,"nom":"Coup de saucisson","element":"T","cm":3,"rayon":{"min":1,"max":1,"modifiable":false},"lancer":"libre","vue":true,"cible":"ennemi","parTour":1,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"T","min":17,"max":21,"maitre":[21,26]},{"type":"etat","etat":"fume","tours":1,"couches":1}],"texte":"Un coup de saucisson bien fumé : l'ennemi en garde l'odeur et frappe moins fort (Fumé : −15 % de dégâts à son prochain tour). Un seul coup par tour : l'autre main garde la tartine pour soigner.","change":""},{"id":"pateladin.saucisson-et-lumiere","classe":"pateladin","emplacement":1,"declinaisonDe":"pateladin.coup-de-saucisson","niveau":3,"nom":"Saucisson et lumière","element":"C","cm":3,"rayon":{"min":1,"max":3,"modifiable":true},"lancer":"ligne","vue":true,"cible":"ennemi","parTour":1,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":10,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"C","min":16,"max":20,"maitre":[20,25]},{"type":"si","condition":"cibleTombe","effets":[{"type":"gainCM","n":1,"qui":"soi"}]}],"texte":"Son et lumière : le saucisson ferré lance un éclair. Si la cible tombe, le spectacle continue.","change":"Le coup au contact devient une estocade en ligne jusqu'à 3 cases, en Éclair ; il ne fume plus la cible, mais rend 1 CM si elle tombe. Toujours un seul par tour, comme le Coup de saucisson."},{"id":"pateladin.fumoir","classe":"pateladin","emplacement":2,"declinaisonDe":null,"niveau":1,"nom":"Fumoir","element":"N","cm":3,"rayon":{"min":1,"max":3,"modifiable":false},"lancer":"libre","vue":false,"cible":"case","parTour":1,"parCible":0,"relance":2,"relanceInitiale":0,"plafondPose":2,"maitre":0,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"allies","effets":[{"type":"pose","quoi":"nappe","tours":2,"declenche":"debut","zone":{"forme":"rond","taille":1,"tailleMin":0,"baisse":false},"touche":"allies","maitre":5,"effets":[{"type":"soin","min":5,"max":7,"maitre":[6,9]}]},{"type":"pose","quoi":"nappe","tours":2,"declenche":"debut","zone":{"forme":"rond","taille":1,"tailleMin":0,"baisse":false},"touche":"ennemis","maitre":0,"effets":[{"type":"etat","etat":"fume","tours":1,"couches":1}]}],"texte":"Le fumoir s'ouvre : sa fumée soigne les alliés et fait tousser les ennemis qui y commencent leur tour. Une seule fumée à la fois : elle tient 2 tours, le temps que le fumoir se recharge (relance 2, comme un soin).","change":""},{"id":"pateladin.fumage-a-froid","classe":"pateladin","emplacement":2,"declinaisonDe":"pateladin.fumoir","niveau":5,"nom":"Fumage à froid","element":"S","cm":3,"rayon":{"min":1,"max":3,"modifiable":false},"lancer":"ligne","vue":true,"cible":"case","parTour":2,"parCible":1,"relance":0,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"cone","taille":1,"tailleMin":0,"baisse":true},"touche":"ennemis","effets":[{"type":"degats","element":"S","min":10,"max":13,"maitre":[13,16]},{"type":"etat","etat":"fume","tours":1,"couches":1}],"texte":"Fumer à froid, c'est sans flamme : juste un courant d'air chargé de fumée.","change":"La fumée ne soigne plus et ne reste pas au sol : soufflée en cône jusqu'à 3 cases devant soi, elle fait des dégâts Soufflé et rend Fumés les ennemis touchés."},{"id":"pateladin.rillettes-reconfortantes","classe":"pateladin","emplacement":3,"declinaisonDe":null,"niveau":1,"nom":"Rillettes réconfortantes","element":"N","cm":3,"rayon":{"min":0,"max":2,"modifiable":false},"lancer":"libre","vue":true,"cible":"allie","parTour":1,"parCible":1,"relance":2,"relanceInitiale":0,"plafondPose":0,"maitre":5,"zone":{"forme":"case","taille":0,"tailleMin":0,"baisse":true},"touche":"allies","effets":[{"type":"si","condition":"cibleBlessee","ef